---
import { hero } from "../config/content";
---
<section class="hero" aria-labelledby="hero-title"><div class="shell hero-grid"><div class="hero-copy" data-reveal><p class="eyebrow">{hero.eyebrow}</p><h1 id="hero-title" class="display hero-title">{hero.title}</h1><p class="body-lg hero-summary">{hero.summary}</p><div class="hero-actions"><a class="button" href={hero.primary.href}>{hero.primary.label} <span aria-hidden="true">↗</span></a><a class="button secondary" href={hero.secondary.href}>{hero.secondary.label}</a></div></div><div class="art-stack" aria-label="A selection of Saurav’s creative work" data-reveal="scale">{hero.artworks.map((image, i) => <figure class={`art art-${String.fromCharCode(97+i)}`}><img src={image} alt="Creative work preview" loading={i ? "lazy" : "eager"} decoding="async" /></figure>)}</div></div></section>
