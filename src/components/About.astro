---
import { about } from "../config/content";
---
<section class="section">
<div class="shell about">
<div data-reveal>
<p class="eyebrow">{about.label}</p>
<h2 class="heading" style="margin-top:1rem">{about.heading}</h2>
<p class="body-lg" style="margin-top:1.5rem">{about.body}</p>
</div>
<img src={about.image} alt="Creative workflow details" loading="lazy" decoding="async" data-reveal="scale" />
</div>
</section>
