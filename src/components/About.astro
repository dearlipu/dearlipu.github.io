---
import { siteConfig } from "../config";
---

<section id="about" class="page-shell content-section" data-reveal>
  <div class="section-heading">
    <span class="eyebrow">01 / about</span>
  </div>
  <div class="about-grid" data-reveal>
    <h2>Useful work,<br /><em>well considered.</em></h2>
    <div>
      <p class="about-copy">{siteConfig.aboutMe}</p>
      <div class="skill-list" aria-label="Skills">
        <div class="skill-entry">
          <span class="skill-label">Languages</span>
          <div class="skill-values">
            {
              siteConfig.languages.map((item) => (
                <span>
                  <span class="skill-plus" aria-hidden="true">+</span>
                  {item}
                </span>
              ))
            }
          </div>
        </div>
        <div class="skill-entry">
          <span class="skill-label">Skills</span>
          <div class="skill-values">
            {
              siteConfig.skills.map((item) => (
                <span>
                  <span class="skill-plus" aria-hidden="true">+</span>
                  {item}
                </span>
              ))
            }
          </div>
        </div>
        <div class="skill-entry">
          <span class="skill-label">Software</span>
          <div class="skill-values">
            {
              siteConfig.software.map((item) => (
                <span>
                  <span class="skill-plus" aria-hidden="true">+</span>
                  {item}
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 8vw, 7rem);
  }

  h2 {
    margin: 0;
    font-family: var(--title-font);
    font-size: clamp(3rem, 6vw, 5.5rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 0.98;
  }

  h2 em {
    color: var(--muted);
    font-style: italic;
  }

  .about-copy {
    margin: 0;
    font-size: clamp(1rem, 1.3vw, 1.12rem);
    line-height: 1.75;
    text-align: justify;
  }

  .skill-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--line);
  }

  .skill-entry {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
    border-bottom: 1px solid var(--line);
    padding: 0.875rem 0;
  }

  .skill-label {
    color: var(--ink);
    font-size: 0.85rem;
  }

  .skill-values {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .skill-values span {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .skill-plus {
    color: var(--accent);
  }

  .experience-row li svg {
    width: 0.9em;
    height: 0.9em;
    flex: 0 0 0.9em;
    color: var(--accent);
  }

  @media (max-width: 700px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .skill-entry {
      grid-template-columns: 6rem minmax(0, 1fr);
      gap: 1rem;
    }
  }
</style>
