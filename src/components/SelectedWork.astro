---
import { work } from "../config/content";
---
<section id="thinking" class="section"><div class="shell"><div class="section-head" data-reveal><div><p class="eyebrow">Proof of thinking</p><h2 class="heading" style="margin-top:1rem">The work behind<br/>the work.</h2></div><p class="body-lg">A few examples of how a constraint becomes a creative decision—and a clearer outcome.</p></div><div class="work-list">{work.map((item) => <article class="case" data-reveal="scale"><div class="case-media"><img src={item.image} alt={`${item.title} project preview`} loading="lazy" decoding="async" /></div><div class="case-body"><div><p class="eyebrow">Case {item.number}</p><h3 style="margin-top:1rem">{item.title}</h3><dl class="case-details"><div><dt>The problem</dt><dd>{item.problem}</dd></div><div><dt>The thinking</dt><dd>{item.thinking}</dd></div><div><dt>The outcome</dt><dd>{item.outcome}</dd></div></dl></div><div class="tags">{item.tags.map((tag) => <span class="tag">{tag}</span>)}</div></div></article>)}</div></div></section>
