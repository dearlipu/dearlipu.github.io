---
import { siteConfig } from "../config";
---

<footer class="page-shell footer">
  <div class="certifications" id="certifications" data-reveal>
    <div class="section-heading">
      <span class="eyebrow">05 / certifications</span>
    </div>
    <ul class="cert-list">
      {
        siteConfig.certifications?.map((cert) => (
          <li>
            <a href={cert.link} target="_blank" rel="noopener noreferrer">
              <div class="cert-copy">
                <span class="cert-name">{cert.name}</span>
                <span class="cert-meta">
                  {cert.year} · {cert.provider}
                </span>
              </div>
              <span class="cert-link-label" aria-label={`Verify ${cert.name}`}>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="icon icon-tabler icons-tabler-outline icon-tabler-circle-dashed-check"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M12 15a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" />
                  <path d="M13 17.5v4.5l2 -1.5l2 1.5v-4.5" />
                  <path d="M10 19h-5a2 2 0 0 1 -2 -2v-10c0 -1.1 .9 -2 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -1 1.73" />
                  <path d="M6 9l12 0" />
                  <path d="M6 12l3 0" />
                  <path d="M6 15l2 0" />
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="footer-grid" data-reveal>
    <div>
      <p class="eyebrow">Have a project in mind?</p>
      <h2>Let's make something<br /><em>useful together.</em></h2>
    </div>
    <div class="footer-links">
      <a class="email-link" href={`mailto:${siteConfig.social.email}`}
        >{siteConfig.social.email}
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="email-icon"
          aria-hidden="true"
        >
          <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
          <path d="M17 7l-10 10"></path>
          <path d="M8 7l9 0l0 9"></path>
        </svg></a
      >
      <div class="socials">
        {
          siteConfig.social.github && (
            <a
              href={siteConfig.social.github}
              target="_blank"
              rel="noopener noreferrer"
            >
              github
            </a>
          )
        }
        {
          siteConfig.social.twitter && (
            <a
              href={siteConfig.social.twitter}
              target="_blank"
              rel="noopener noreferrer"
            >
              twitter
            </a>
          )
        }
        {
          siteConfig.social.website && (
            <a
              href={siteConfig.social.website}
              target="_blank"
              rel="noopener noreferrer"
            >
              website
            </a>
          )
        }
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <span class="footer-brand">
      <span class="footer-brand-mark" aria-hidden="true">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
          <path
            d="M3 5a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v14a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-14"
          ></path>
          <path d="M12 8.5v7"></path>
          <path d="M9 10l6 4"></path>
          <path d="M9 14l6 -4"></path>
        </svg>
      </span>
      {siteConfig.name}
    </span>
    <span class="footer-meta">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="footer-copyright-icon"
        aria-hidden="true"
      >
        <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
        <path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
        <path
          d="M14 9.75a3.016 3.016 0 0 0 -4.163 .173a2.993 2.993 0 0 0 0 4.154a3.016 3.016 0 0 0 4.163 .173"
        ></path>
      </svg>
      {new Date().getFullYear()} · Built with care ❤
    </span>
  </div>
</footer>

<style>
  .footer {
    padding: var(--section-space) 0 1.5rem;
  }

  .certifications {
    padding: 0;
  }

  .section-heading {
    margin-bottom: 1.25rem;
  }

  .cert-list {
    list-style: none;
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
  }

  .cert-list li {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.5;
    border: 1px solid var(--line);
    border-left: 2px solid var(--accent);
    transition: border-color 180ms ease, background-color 180ms ease,
      transform 180ms ease;
  }

  .cert-list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.8rem 1rem;
    color: var(--muted);
    text-decoration: none;
    transition: color 180ms ease;
  }

  .cert-list a:hover,
  .cert-list a:focus-visible {
    color: var(--ink);
  }

  .cert-list li:hover,
  .cert-list li:focus-within {
    border-color: var(--accent);
    background: var(--hover-surface);
    transform: translateY(-2px);
  }

  .cert-copy {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }
  .cert-name {
    color: var(--ink);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.85rem;
    line-height: 1.4;
  }

  .cert-meta {
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.72rem;
    text-transform: uppercase;
  }

  .cert-link-label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: none;
    border-radius: 0;
    background: transparent;
    color: var(--muted);
    flex-shrink: 0;
    transition: color 180ms ease, transform 180ms ease;
  }

  .cert-list a:hover .cert-link-label {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  .cert-link-label svg {
    width: 18px;
    height: 18px;
    display: block;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.7fr);
    gap: clamp(2rem, 8vw, 7rem);
    padding: clamp(3.5rem, 7vw, 5.5rem) 0;
    border-bottom: 1px solid var(--line);
  }

  h2 {
    margin: 1.5rem 0 0;
    font-family: var(--title-font);
    font-size: clamp(3rem, 6vw, 5.5rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 0.98;
  }

  h2 em {
    color: var(--muted);
    font-style: italic;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: start;
    gap: 1.5rem;
    padding-bottom: 0.25rem;
  }

  .email-link {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    border-bottom: 1px solid var(--line);
    padding: 0.5rem 0 0.65rem;
    font-size: clamp(0.95rem, 1.4vw, 1.1rem);
    text-decoration: none;
    transition: border-color 180ms ease, color 180ms ease;
  }

  .email-link:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .email-icon {
    width: 18px;
    height: 18px;
    color: var(--accent);
    display: block;
    flex-shrink: 0;
  }
  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .socials a {
    color: var(--muted);
    font-size: 0.9rem;
    text-decoration: none;
    text-underline-offset: 0.25em;
  }

  .socials a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-top: 1rem;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
  }
  .footer-brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    color: var(--accent);
    line-height: 1;
  }
  .footer-brand-mark svg {
    display: block;
    width: 18px;
    height: 18px;
  }
  .footer-meta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    white-space: nowrap;
  }
  .footer-copyright-icon {
    width: 14px;
    height: 14px;
    display: block;
    flex-shrink: 0;
  }
  @media (max-width: 700px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 480px) {
    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
    }

    .footer-meta {
      white-space: normal;
    }
  }
</style>
