---
import { siteConfig } from "../config";

const plans = [
  {
    name: "Quick Start",
    audience: "For one clear task or a small content need.",
    badge: null,
    discount: "10% OFF",
    icon: "sparkles",
    projectPrice: "₹1,999+",
    monthlyPrice: "₹9,999/mo",
  },
  {
    name: "Growth",
    audience: "For brands that need regular content and campaign support.",
    badge: "Most Popular",
    discount: "15% OFF",
    icon: "heart",
    projectPrice: "₹5,999+",
    monthlyPrice: "₹19,999/mo",
  },
  {
    name: "Professional",
    audience: "For growing teams that need a reliable creative partner.",
    badge: null,
    discount: "20% OFF",
    icon: "shield",
    projectPrice: "₹17,999+",
    monthlyPrice: "₹39,999/mo",
  },
];
---

<section id="pricing" class="px-6 py-14 sm:px-10 sm:py-16 md:px-14 lg:px-20 lg:py-24">
  <div class="mx-auto max-w-6xl reveal-up">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-4">
        <p class="inline-flex rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-blue-700">
          Pricing
        </p>

        <h2 class="mt-4 text-3xl font-bold leading-tight text-gray-900 sm:text-4xl md:text-5xl">
          Flexible Pricing.
        </h2>

        <div class="mt-3 h-1.5 w-20 rounded-full" style={`background-color: ${siteConfig.accentColor}`}></div>

        <p class="mt-5 max-w-sm text-sm leading-relaxed text-gray-600 sm:text-base">
          Compare the level of support you need, from one simple task to ongoing creative work.
        </p>

        <div class="mt-6" role="group" aria-label="Pricing mode toggle">
          <p class="mb-2 text-xs font-semibold uppercase tracking-[0.12em] text-gray-500">
            How would you like to work?
          </p>
          <div class="relative grid h-11 w-full max-w-[340px] grid-cols-2 rounded-full bg-gray-200 p-1">
            <div id="toggleSlider" class="toggle-slider"></div>

            <button id="perProjectBtn" type="button" class="toggle-btn toggle-btn-active" aria-pressed="true">
              One Project
            </button>
            <button id="monthlyBtn" type="button" class="toggle-btn" aria-pressed="false">
              Monthly Support
            </button>
          </div>
        </div>
      </div>

      <div class="lg:col-span-8">
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {
            plans.map((plan) => (
              <article class={`pricing-card ${plan.badge ? "pricing-card-featured" : ""}`} style={`--accent-color: ${siteConfig.accentColor}`}>
                {
                  plan.badge && (
                    <span class="pricing-badge" style={`background-color: ${siteConfig.accentColor}`}>
                      {plan.badge}
                    </span>
                  )
                }
                <span class="discount-badge" aria-label={`${plan.discount} discount`}><span>{plan.discount}</span></span>

                <div class="pricing-card-icon" aria-hidden="true">
                  {
                    plan.icon === "sparkles" && (
                      <svg xmlns="http://www.w3.org/2000/svg" class="pricing-card-icon-svg w-[180px] h-[180px] md:w-[140px] md:h-[140px] lg:w-[140px] lg:h-[140px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M16 18a2 2 0 0 1 2 2a2 2 0 0 1 2 -2a2 2 0 0 1 -2 -2a2 2 0 0 1 -2 2m0 -12a2 2 0 0 1 2 2a2 2 0 0 1 2 -2a2 2 0 0 1 -2 -2a2 2 0 0 1 -2 2m-7 12a6 6 0 0 1 6 -6a6 6 0 0 1 -6 -6a6 6 0 0 1 -6 6a6 6 0 0 1 6 6" />
                      </svg>
                    )
                  }
                  {
                    plan.icon === "heart" && (
                      <svg xmlns="http://www.w3.org/2000/svg" class="pricing-card-icon-svg w-[180px] h-[180px] md:w-[140px] md:h-[140px] lg:w-[140px] lg:h-[140px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M19.5 12.572l-7.5 7.428l-7.5 -7.428a5 5 0 1 1 7.5 -6.566a5 5 0 1 1 7.5 6.572" />
                      </svg>
                    )
                  }
                  {
                    plan.icon === "shield" && (
                      <svg xmlns="http://www.w3.org/2000/svg" class="pricing-card-icon-svg w-[180px] h-[180px] md:w-[140px] md:h-[140px] lg:w-[140px] lg:h-[140px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M5 7.2a2.2 2.2 0 0 1 2.2 -2.2h1a2.2 2.2 0 0 0 1.55 -.64l.7 -.7a2.2 2.2 0 0 1 3.12 0l.7 .7c.412 .41 .97 .64 1.55 .64h1a2.2 2.2 0 0 1 2.2 2.2v1c0 .58 .23 1.138 .64 1.55l.7 .7a2.2 2.2 0 0 1 0 3.12l-.7 .7a2.2 2.2 0 0 0 -.64 1.55v1a2.2 2.2 0 0 1 -2.2 2.2h-1a2.2 2.2 0 0 0 -1.55 .64l-.7 .7a2.2 2.2 0 0 1 -3.12 0l-.7 -.7a2.2 2.2 0 0 0 -1.55 -.64h-1a2.2 2.2 0 0 1 -2.2 -2.2v-1a2.2 2.2 0 0 0 -.64 -1.55l-.7 -.7a2.2 2.2 0 0 1 0 -3.12l.7 -.7a2.2 2.2 0 0 0 .64 -1.55v-1" />
                        <path d="M9 12l2 2l4 -4" />
                      </svg>
                    )
                  }
                </div>

                <h3 class="text-lg font-bold text-gray-900">{plan.name}</h3>
                <p class="mt-1 text-xs leading-relaxed text-gray-500">{plan.audience}</p>
                <p
                  class="price mt-2 text-2xl font-bold text-gray-800 transition-opacity duration-200"
                  data-project={plan.projectPrice}
                  data-monthly={plan.monthlyPrice}
                >
                  {plan.projectPrice}
                </p>

                <ul class="features mt-4 flex-1 space-y-2 text-sm leading-relaxed text-gray-600"></ul>

                <button
                  type="button"
                  data-plan={plan.name}
                  class="email-btn btn-primary mt-6 w-full rounded-xl px-4 py-2.5 text-center text-sm font-semibold"
                  style={`--accent: ${siteConfig.accentColor}`}
                >
                  Request Quote
                </button>
              </article>
            ))
          }
        </div>

        <p class="mt-6 text-sm text-gray-500">Not sure what you need? Tell me your goal and I’ll suggest the simplest option.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .toggle-slider {
    position: absolute;
    top: 4px;
    left: 4px;
    z-index: 0;
    height: calc(100% - 8px);
    width: calc(50% - 4px);
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.2);
    transition: transform 0.25s ease;
  }

  .toggle-btn {
    z-index: 1;
    border: 0;
    background: transparent;
    font-size: 0.85rem;
    font-weight: 600;
    color: #6b7280;
  }

  .toggle-btn-active {
    color: #111827;
  }

  .pricing-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: 1rem;
    border: 1px solid #e5e7eb;
    background-color: #f9fafb;
    padding: 1.25rem;
    overflow: visible;
    transition: box-shadow 0.2s ease;
  }

  .pricing-card-icon {
    position: absolute;
    inset: 0;
    overflow: hidden;
    opacity: 0.06;
    pointer-events: none;
  }

  .pricing-card-icon-svg {
    position: absolute;
    right: -30px;
    top: -30px;

  }

  .pricing-card:hover {
    box-shadow: 0 10px 18px rgba(15, 23, 42, 0.12);
  }

  .pricing-card-featured {
    border-width: 2px;
    border-color: var(--accent-color, #1d4ed8);
  }

  .pricing-badge {
    position: absolute;
    top: -0.75rem;
    left: 50%;
    z-index: 2;
    transform: translateX(-50%);
    border-radius: 999px;
    padding: 0.25rem 0.65rem;
    font-size: 0.72rem;
    font-weight: 700;
    color: #fff;
    box-shadow: 0 8px 18px rgba(15, 23, 42, 0.2);
    white-space: nowrap;
  }

  .discount-badge {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 2;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--accent-color, #1d4ed8) 22%, white);
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent-color, #1d4ed8) 8%, white);
    padding: 0.28rem 0.52rem;
    color: var(--accent-color, #1d4ed8);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    white-space: nowrap;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06);
    transition: transform 0.25s ease, box-shadow 0.25s ease, background-color 0.25s ease;
  }

  .discount-badge::after {
    position: absolute;
    top: 0;
    bottom: 0;
    left: -45%;
    width: 30%;
    background: rgba(255, 255, 255, 0.8);
    content: "";
    transform: skewX(-20deg);
    animation: discountShine 4.5s ease-in-out infinite;
  }

  .discount-badge > span {
    position: relative;
    top: 2px;
  }

  .pricing-card:hover .discount-badge {
    background: color-mix(in srgb, var(--accent-color, #1d4ed8) 13%, white);
    box-shadow: 0 7px 16px rgba(15, 23, 42, 0.1);
    transform: translateY(-2px);
  }

  @keyframes discountShine {
    0%, 68% { left: -45%; opacity: 0; }
    75% { opacity: 0.8; }
    88%, 100% { left: 125%; opacity: 0; }
  }

  .btn-primary {
    border: 0;
    background-color: #0f172a;
    color: #fff;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .btn-primary:hover,
  .btn-primary:focus-visible {
    background-color: var(--accent);
    transform: translateY(-1px);
    outline: none;
  }

  @media (max-width: 640px) {
    .toggle-btn {
      font-size: 0.78rem;
    }
  }
</style>

<script>
  let currentMode = "project";

  const perBtn = document.getElementById("perProjectBtn") as HTMLButtonElement | null;
  const monthlyBtn = document.getElementById("monthlyBtn") as HTMLButtonElement | null;
  const slider = document.getElementById("toggleSlider") as HTMLElement | null;

  const prices = document.querySelectorAll<HTMLElement>(".price");
  const features = document.querySelectorAll<HTMLElement>(".features");
  const buttons = document.querySelectorAll<HTMLButtonElement>(".email-btn");

  const featureData = {
    project: [
              ["One design or video deliverable", "Two concept options", "Two revision rounds included", "Final files ready to publish"],
              ["A launch campaign or content set", "Multiple design and video assets", "Two revision rounds per asset", "Source files included"],
              ["A full campaign or content system", "Design, video, and motion support", "Priority project timeline", "Planning and source files included"],
    ],
    monthly: [
              ["Up to 4 deliverables each month", "One active request at a time", "Design and short-form video", "Pause or resume anytime"],
              ["Up to 8 deliverables each month", "Two active requests", "More formats and priority delivery", "Weekly progress updates"],
              ["Up to 16 deliverables each month", "Two active requests at a time", "Design, video, and motion support", "Monthly planning and priority support"],
    ],
  };

  function setMode(mode: "project" | "monthly") {
    currentMode = mode;

    prices.forEach((price, index) => {
      price.style.opacity = "0.2";
      setTimeout(() => {
        price.textContent = mode === "monthly" ? price.dataset.monthly ?? "" : price.dataset.project ?? "";
        price.style.opacity = "1";
      }, 120);

      const list = featureData[mode][index];
      features[index].innerHTML = list
        .map(
          (item: string) => `
            <li class="flex items-start gap-2">
              <svg xmlns="http://www.w3.org/2000/svg"
                class="mt-[0.15em] block h-5 w-5 shrink-0 text-gray-400"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0" />
                <path d="M9 12h6" />
                <path d="M12 9v6" />
              </svg>
              <span>${item}</span>
            </li>
          `,
        )
        .join("");
    });

    const isMonthly = mode === "monthly";
    if (!slider || !perBtn || !monthlyBtn) {
      return;
    }

    slider.style.transform = isMonthly ? "translateX(100%)" : "translateX(0)";

    perBtn.classList.toggle("toggle-btn-active", !isMonthly);
    monthlyBtn.classList.toggle("toggle-btn-active", isMonthly);
    perBtn.setAttribute("aria-pressed", String(!isMonthly));
    monthlyBtn.setAttribute("aria-pressed", String(isMonthly));
  }

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const plan = button.dataset.plan || "";
      const contactSection = document.getElementById("contact");

      window.dispatchEvent(
        new CustomEvent("pricing-plan-selected", {
          detail: {
            plan,
            mode: currentMode,
          },
        }),
      );

      if (contactSection) {
        contactSection.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    });
  });

  perBtn?.addEventListener("click", () => setMode("project"));
  monthlyBtn?.addEventListener("click", () => setMode("monthly"));

  setMode("project");
</script>
