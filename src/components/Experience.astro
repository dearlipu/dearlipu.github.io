---
import { siteConfig } from "../config";
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
---

{
  hasExperience && (
    <section id="experience" class="page-shell content-section" data-reveal>
      <div class="section-heading">
        <span class="eyebrow">03 / experience</span>
      </div>
      <div class="experience-list">
        {siteConfig.experience.map((exp) => (
          <article class="experience-row" data-reveal>
            <h3>{exp.title}</h3>
            <div class="meta">
              <p class="date">{exp.dateRange}</p>
              {exp.jobType && <p class="job-type">{exp.jobType}</p>}
            </div>
            <p class="company">{exp.company}</p>
            <ul>
              {exp.bullets.map((bullet) => (
                <li>
                  <span class="bullet-plus" aria-hidden="true">+</span>
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>
  )
}

<style>
  .experience-list {
    border-top: 1px solid var(--line);
  }

  .experience-row {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    grid-template-areas:
      "title meta"
      "company bullets";
    column-gap: clamp(2rem, 8vw, 7rem);
    row-gap: 0;
    border-bottom: 1px solid var(--line);
    padding: clamp(1.25rem, 2.5vw, 2rem) 0;
  }

  h3 {
    grid-area: title;
    margin: 0;
    font-family: var(--title-font);
    font-size: clamp(1.6rem, 2.5vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .company,
  .date,
  .job-type {
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .company {
    grid-area: company;
    max-width: 24rem;
    margin: 0.55rem 0 0;
  }

  .meta {
    grid-area: meta;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 1rem;
    padding-top: 0.6rem;
  }

  ul {
    grid-area: bullets;
    list-style: none;
    margin: 0.55rem 0 0;
    padding: 0;
  }

  .date,
  .job-type {
    margin: 0;
  }

  .job-type {
    text-align: right;
  }

  li {
    display: grid;
    grid-template-columns: 0.9em minmax(0, 1fr);
    align-items: start;
    gap: 0.35rem;
    margin: 0 0 0.55rem;
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.65;
  }

  .bullet-plus {
    color: var(--accent);
  }

  @media (max-width: 820px) {
    .experience-row {
      grid-template-columns: 1fr;
      grid-template-areas:
        "title"
        "company"
        "meta"
        "bullets";
      column-gap: 0;
    }

    .meta {
      margin-top: 1rem;
    }

    ul {
      margin-top: 0.85rem;
    }
  }
</style>
