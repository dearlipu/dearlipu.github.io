---
import { process } from "../config/content";
---
<section class="section process"><div class="shell"><div class="section-head" data-reveal><div><p class="eyebrow">How I work</p><h2 class="heading" style="margin-top:1rem">A good idea needs<br/>a good way through.</h2></div></div><div class="process-grid">{process.map(([number,title,description]) => <article class="step" data-reveal><span class="eyebrow">{number}</span><h3>{title}</h3><p>{description}</p></article>)}</div></div></section>
