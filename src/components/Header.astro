---
import { siteConfig } from "../config";

const hasServices = siteConfig.services && siteConfig.services.length > 0;
---

<header id="header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-transparent">

  <div class="flex md:hidden justify-end px-6 py-4">
    <button id="menuBtn"
      class="flex items-center justify-center gap-2 px-4 py-2.5 rounded-full text-sm font-medium leading-none
      bg-[#101828] text-white shadow-lg transition active:scale-95">

      <span class="relative top-px inline-flex items-center leading-none">Menu</span>

      <svg id="menuIcon" xmlns="http://www.w3.org/2000/svg"
        class="block w-4 h-4 shrink-0 transition-transform duration-300"
        fill="none" viewBox="0 0 24 24"
        stroke="currentColor" stroke-width="2">
        
        <path id="iconPath"
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12 5v14M5 12h14" />
      </svg>
    </button>
  </div>

  <!-- FLOATING MENU -->
  <div id="menuPanel"
    class="fixed left-1/2 top-[4.75rem] w-[calc(100%-2rem)] max-w-xs -translate-x-1/2 h-[min(52vh,360px)] overflow-hidden overscroll-contain bg-[#101828] text-white rounded-3xl p-5 shadow-2xl border border-gray-700 z-50
    
    opacity-0 scale-90 translate-y-6 pointer-events-none origin-[50%_-10px]
    transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]">

    <ul class="menu-list text-lg">

      <li class="menu-item">
        <a href="#about" class="menu-link font-semibold">
          About
          <svg class="arrow-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M7 17L17 7M17 7H7M17 7V17"/>
          </svg>
        </a>
      </li>

      {hasServices && (
      <li class="menu-item">
        <a href="#services" class="menu-link font-semibold">
          Services
          <svg class="arrow-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M7 17L17 7M17 7H7M17 7V17"/>
          </svg>
        </a>
      </li>
      )}

      <li class="menu-item">
        <a href="#pricing" class="menu-link font-semibold">
          Pricing
          <svg class="arrow-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M7 17L17 7M17 7H7M17 7V17"/>
          </svg>
        </a>
      </li>

      <li class="menu-item">
        <a href="#testimonials" class="menu-link font-semibold">
          Reviews
          <svg class="arrow-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M7 17L17 7M17 7H7M17 7V17"/>
          </svg>
        </a>
      </li>

      <li class="menu-item">
        <a href="#contact" class="menu-link font-semibold">
          Contact
          <svg class="arrow-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M7 17L17 7M17 7H7M17 7V17"/>
          </svg>
        </a>
      </li>

      <li class="menu-item">
        <a href="/faq" class="menu-link font-semibold">
          FAQs
          <svg class="arrow-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M7 17L17 7M17 7H7M17 7V17"/>
          </svg>
        </a>
      </li>
      
      <li class="menu-item">
        <a href="/privacy" class="menu-link font-semibold">
          Privacy Policy
          <svg class="arrow-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M7 17L17 7M17 7H7M17 7V17"/>
          </svg>
        </a>
      </li>
      
      <li class="menu-item">
        <a href="/terms" class="menu-link font-semibold">
          Terms of Service
          <svg class="arrow-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M7 17L17 7M17 7H7M17 7V17"/>
          </svg>
        </a>
      </li>

      <li class="menu-item">
        <a href="/copyright" class="menu-link font-semibold">
          Copyright
          <svg class="arrow-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M7 17L17 7M17 7H7M17 7V17"/>
          </svg>
        </a>
      </li>

    </ul>
  </div>

  <!-- DESKTOP NAV -->
  <nav class="hidden md:block max-w-7xl mx-auto px-8 py-4">
    <ul class="flex items-center gap-8 justify-center">
      <li><a href="#about" class="nav-link">About</a></li>
      {hasServices && <li><a href="#services" class="nav-link">Services</a></li>}
      <li><a href="#pricing" class="nav-link">Pricing</a></li>
      <li><a href="#testimonials" class="nav-link">Reviews</a></li>
      <li><a href="#contact" class="nav-link">Contact</a></li>
    </ul>
  </nav>

</header>

<script is:inline>
document.addEventListener("DOMContentLoaded", () => {

  const header = document.getElementById("header");
  const btn = document.getElementById("menuBtn");
  const panel = document.getElementById("menuPanel");
  const icon = document.getElementById("menuIcon");
  const path = document.getElementById("iconPath");

  let open = false;

  function openMenu() {
    panel.classList.remove("opacity-0","scale-90","translate-y-6","pointer-events-none");
    panel.classList.add("opacity-100","scale-100","translate-y-0","menu-open");

    icon.style.transform = "rotate(180deg)";
    path.setAttribute("d","M6 6l12 12M6 18L18 6");

    open = true;
  }

  function closeMenu() {
    panel.classList.add("opacity-0","scale-90","translate-y-6","pointer-events-none");
    panel.classList.remove("opacity-100","scale-100","translate-y-0","menu-open");

    icon.style.transform = "rotate(0deg)";
    path.setAttribute("d","M12 5v14M5 12h14");

    open = false;
  }

  btn.addEventListener("click", () => {
    open ? closeMenu() : openMenu();
  });

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!open || !(target instanceof Node)) return;

    if (panel.contains(target) || btn.contains(target)) return;

    closeMenu();
  });

  document.querySelectorAll('a[href^="#"]').forEach(link => {
    link.addEventListener("click", function(e) {
      e.preventDefault();

      const target = document.querySelector(this.getAttribute("href"));

      if (target) {
        const y = target.getBoundingClientRect().top + window.scrollY - 80;

        window.scrollTo({
          top: y,
          behavior: "smooth"
        });
      }

      closeMenu();
    });
  });

  window.addEventListener("scroll", () => {
    if (window.scrollY > 100) {
      header.classList.add("bg-white/80", "backdrop-blur-sm");
    } else {
      header.classList.remove("bg-white/80", "backdrop-blur-sm");
    }
  });

});
</script>

<style>
html {
  scroll-behavior: smooth;
}

.menu-link {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px 8px 13px;
  border-bottom: 1px solid rgba(29,78,216,0.1);
  transition: none;
  border-radius: 0.75rem;
}

.menu-list {
  height: 100%;
  max-height: none;
  overflow-y: auto;
  overscroll-behavior: contain;
  scrollbar-width: none;
}

.menu-list::-webkit-scrollbar {
  display: none;
}

.menu-item:first-child .menu-link {
  border-top: 1px solid rgba(29,78,216,0.1);
}

.menu-link:hover {
  background-color: transparent;
  box-shadow: none;
  opacity: 1;
  transform: none;
}

.menu-link:active {
  transform: none;
}

.arrow-icon {
  width: 22px;
  height: 22px;
  stroke: #fff;
  stroke-width: 2;
  opacity: 0.9;
  transition: transform 0.25s ease;
}

.menu-link:hover .arrow-icon {
  transform: translate(3px, -3px);
}

.menu-item {
  opacity: 0;
  transform: translateY(10px);
}

.menu-open .menu-item {
  animation: fadeUp 0.45s cubic-bezier(0.16,1,0.3,1) forwards;
}

.menu-item:nth-child(1) { animation-delay: 0.05s; }
.menu-item:nth-child(2) { animation-delay: 0.1s; }
.menu-item:nth-child(3) { animation-delay: 0.15s; }
.menu-item:nth-child(4) { animation-delay: 0.2s; }

@keyframes fadeUp {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
</style>
