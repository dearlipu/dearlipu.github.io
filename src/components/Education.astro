---
import { siteConfig } from "../config";
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
---

{
  hasEducation && (
    <section id="education" class="page-shell content-section" data-reveal>
      <div class="section-heading">
        <span class="eyebrow">04 / education</span>
      </div>
      <div class="education-list">
        {siteConfig.education.map((edu) => (
          <article class="education-row" data-reveal>
            <div>
              <h3>{edu.degree}</h3>
              <p>{edu.school}</p>
            </div>
            <span>{edu.dateRange}</span>
          </article>
        ))}
      </div>
    </section>
  )
}

<style>
  .education-list {
    border-top: 1px solid var(--line);
  }

  .education-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 2rem;
    border-bottom: 1px solid var(--line);
    padding: 1.25rem 0;
  }

  h3 {
    margin: 0;
    font-family: var(--title-font);
    font-size: clamp(1.5rem, 2.4vw, 2.1rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  p,
  .education-row > span {
    margin: 0;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  p {
    margin-top: 0.5rem;
  }

  .education-row > span {
    white-space: nowrap;
  }

  @media (max-width: 600px) {
    .education-row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .education-row > span {
      white-space: normal;
    }
  }
</style>
