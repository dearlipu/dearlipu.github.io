---
import { siteConfig } from "../config";
const whatsappNumber = siteConfig.social.whatsapp;
---

<section
  id="contact"
  class="px-6 py-14 sm:px-10 sm:py-16 md:px-14 lg:px-20 lg:py-24"
>
  <div class="mx-auto max-w-6xl reveal-up">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-4">
        <p
          class="inline-flex rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-blue-700"
        >
          Contact
        </p>

        <h2
          class="mt-4 text-3xl font-bold leading-tight text-gray-900 sm:text-4xl md:text-5xl"
        >
          Ready to Start?
        </h2>

        <div
          class="mt-3 h-1.5 w-20 rounded-full"
          style={`background-color: ${siteConfig.accentColor}`}
        >
        </div>

        <p
          class="mt-5 max-w-sm text-sm leading-relaxed text-gray-600 sm:text-base"
        >
          Tell me what you need. I’ll reply with clear next steps, a timeline,
          and a quote.
        </p>

        <div class="mt-6 rounded-xl border border-gray-200 bg-gray-50 p-4">
          <p class="text-sm font-semibold text-gray-900">Quick reply</p>
          <p class="mt-1 text-sm text-gray-600">
            I usually reply within a few hours on business days.
          </p>
        </div>
      </div>

      <div class="lg:col-span-8">
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          <form
            id="contactForm"
            class="contact-card"
            action="https://api.web3forms.com/submit"
            method="POST"
          >
            <input
              type="hidden"
              name="access_key"
              value="aaa1a363-68ef-4392-b49f-e920b73930b5"
            />
            <input type="hidden" name="subject" value="New Project Inquiry" />
            <input type="hidden" name="from_name" value="dearlipu website" />
            <input
              type="checkbox"
              name="botcheck"
              class="hidden"
              style="display: none;"
            />

            <h3 class="text-lg font-semibold text-gray-900">
              Tell me about your project
            </h3>
            <p class="mt-1 text-sm text-gray-500">
              Fields marked with * are required.
            </p>

            <div class="mt-5 space-y-4">
              <div>
                <label for="name" class="field-label">Your Name *</label>
                <input
                  id="name"
                  name="name"
                  required
                  autocomplete="name"
                  placeholder="e.g., John Smith"
                  class="input"
                />
              </div>

              <div>
                <label for="email" class="field-label">Email Address *</label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  placeholder="e.g., john@example.com"
                  class="input"
                />
              </div>

              <!--<div>
                <label for="whatsapp" class="field-label">WhatsApp Number</label>
                <input id="whatsapp" name="whatsapp" type="tel" autocomplete="tel" placeholder="e.g., +91 98765 43210" class="input" />
              </div>-->

              <div
                id="timelineBudgetGroup"
                class="grid grid-cols-1 gap-4 sm:grid-cols-2"
              >
                <div>
                  <label for="timeline" class="field-label">Timeline</label>
                  <select
                    id="timeline"
                    name="timeline"
                    class="input select-input"
                  >
                    <option value="">Choose timeline</option>
                    <option>Urgent (1–3 days)</option>
                    <option>Standard (4–7 days)</option>
                    <option>Extended (1–2 weeks)</option>
                    <option>Flexible / No deadline</option>
                  </select>
                </div>

                <div>
                  <label for="budget" class="field-label">Budget</label>
                  <select id="budget" name="budget" class="input select-input">
                    <option value="">Choose budget range</option>
                    <option>₹1k–₹3k (Basic)</option>
                    <option>₹3k–₹10k (Standard)</option>
                    <option>₹10k–₹25k (Advanced)</option>
                    <option>₹25k+ (Premium)</option>
                    <option>Not sure yet</option>
                  </select>
                </div>
              </div>

              <div>
                <label for="details" class="field-label"
                  >What do you need? *</label
                >
                <textarea
                  id="details"
                  name="details"
                  required
                  rows="4"
                  placeholder="Tell me what you want to create, who it is for, and any links or examples you have."
                  class="input textarea"></textarea>
              </div>

              <div id="selectedPlanWrapper" class="hidden">
                <label for="selectedPlan" class="field-label"
                  >Selected Plan</label
                >
                <input
                  id="selectedPlan"
                  name="selectedPlan"
                  readonly
                  class="input input-readonly"
                  placeholder="Choose a plan from pricing above"
                />
              </div>
            </div>

            <p
              id="formStatus"
              class="mt-4 hidden rounded-md border px-3 py-2 text-sm"
            >
            </p>

            <button
              type="submit"
              class="btn-primary mt-5 w-full rounded-xl py-3 text-sm font-semibold sm:text-base"
              style={`--accent: ${siteConfig.accentColor}`}
            >
              Submit Project Brief
            </button>
          </form>

          <aside
            class="image-card rounded-2xl border border-gray-200 bg-white p-4 shadow-sm"
          >
            <div class="contact-image-wrap relative overflow-hidden rounded-xl">
              <img
                src="/images/contact.webp"
                alt="Preview of visual creative workflow"
                class="contact-image"
              />
              <a
                href="/portfolio/"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Open my portfolio in a new tab"
                title="Open portfolio"
                class="qr-link"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="contact-qr"
                  aria-hidden="true"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path
                    d="M4 5a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1l0 -4"
                  ></path>
                  <path d="M7 17l0 .01"></path>
                  <path
                    d="M14 5a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1l0 -4"
                  ></path>
                  <path d="M7 7l0 .01"></path>
                  <path
                    d="M4 15a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1l0 -4"
                  ></path>
                  <path d="M17 7l0 .01"></path>
                  <path d="M14 14l3 0"></path>
                  <path d="M20 14l0 .01"></path>
                  <path d="M14 14l0 3"></path>
                  <path d="M14 20l3 0"></path>
                  <path d="M17 17l3 0"></path>
                  <path d="M20 17l0 3"></path>
                </svg>
              </a>
            </div>

            <div
              class="contact-direct-panel relative mt-4 overflow-hidden rounded-xl border border-gray-100 bg-gray-50 p-4"
            >
              <p class="text-sm font-semibold text-gray-900">
                Want to talk directly?
              </p>
              <div class="mt-3 flex flex-wrap gap-3">
                <div
                  class="quick-contact"
                  style={`--accent: ${siteConfig.accentColor}`}
                >
                  <span class="quick-icon-bubble" aria-hidden="true">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="quick-link-icon"
                    >
                      <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                      <path
                        d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10"
                      ></path>
                      <path d="M3 7l9 6l9 -6"></path>
                    </svg>
                  </span>
                  <a
                    href={`mailto:${siteConfig.social.email}`}
                    class="quick-link"
                  >
                    <span>{siteConfig.social.email}</span>
                  </a>
                </div>
                <div
                  class="quick-contact"
                  style={`--accent: ${siteConfig.accentColor}`}
                >
                  <span class="quick-icon-bubble" aria-hidden="true">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="quick-link-icon"
                    >
                      <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                      <path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9"
                      ></path>
                      <path
                        d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1"
                      ></path>
                    </svg>
                  </span>
                  <a
                    href={`https://wa.me/${whatsappNumber}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="quick-link"
                  >
                    <span
                      >+{siteConfig.social.whatsapp.slice(0, 2)}
                      {siteConfig.social.whatsapp.slice(2)}</span
                    >
                  </a>
                </div>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-card {
    border-radius: 1rem;
    border: 1px solid #e5e7eb;
    background: linear-gradient(145deg, #ffffff, #f8fafc);
    padding: 1.25rem;
    box-shadow: 0 8px 30px rgba(15, 23, 42, 0.05);
  }

  .field-label {
    display: inline-block;
    margin-bottom: 0.35rem;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #4b5563;
  }

  .input {
    width: 100%;
    border-radius: 0.8rem;
    border: 1px solid #d1d5db;
    background: #fff;
    padding: 0.75rem 0.9rem;
    font-size: 0.95rem;
    color: #111827;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .input::placeholder {
    color: #9ca3af;
  }

  .input:focus {
    outline: none;
    border-color: var(--accent, #1d4ed8);
    box-shadow: 0 0 0 3px rgba(29, 78, 216, 0.12);
  }

  .select-input {
    appearance: none;
    background-image:
      linear-gradient(45deg, transparent 50%, #6b7280 50%),
      linear-gradient(135deg, #6b7280 50%, transparent 50%);
    background-position:
      calc(100% - 18px) calc(50% - 2px),
      calc(100% - 12px) calc(50% - 2px);
    background-size:
      6px 6px,
      6px 6px;
    background-repeat: no-repeat;
    padding-right: 2.2rem;
  }

  .textarea {
    min-height: 120px;
    resize: vertical;
  }

  .field-optional {
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
    color: #6b7280;
  }

  .input-readonly {
    background: #f8fafc;
    color: #374151;
  }

  .btn-primary {
    border: none;
    background: #0f172a;
    color: #fff;
    transition:
      transform 0.2s ease,
      background-color 0.2s ease;
  }

  .contact-card-plan-selected {
    animation: contactPulse 1.15s ease;
  }

  @keyframes contactPulse {
    0% {
      box-shadow:
        0 8px 30px rgba(15, 23, 42, 0.05),
        0 0 0 0 rgba(29, 78, 216, 0.25);
    }
    40% {
      box-shadow:
        0 8px 30px rgba(15, 23, 42, 0.08),
        0 0 0 12px rgba(29, 78, 216, 0.12);
    }
    100% {
      box-shadow:
        0 8px 30px rgba(15, 23, 42, 0.05),
        0 0 0 0 rgba(29, 78, 216, 0);
    }
  }

  .btn-primary:hover,
  .btn-primary:focus-visible {
    background: var(--accent);
    transform: translateY(-1px);
  }

  .image-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 100%;
  }

  .contact-image {
    height: 100%;
    min-height: 260px;
    width: 100%;
    object-fit: cover;
  }

  .quick-link {
    top: 0;
    min-width: 0;
    max-width: calc(100% - 2.8rem);
    flex: 0 1 auto;
    display: inline-flex;
    min-height: 2.25rem;
    align-items: center;
    gap: 0.5rem;
    border-radius: 999px;
    border: 1px solid #d1d5db;
    background: #fff;
    padding: 0.45rem 0.85rem;
    font-size: 0.9rem;
    line-height: 1.15;
    font-weight: 600;
    color: #374151;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-decoration: none;
    cursor: pointer;
    transition:
      border-color 0.25s ease,
      color 0.25s ease,
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .quick-link > span {
    position: relative;
    top: 2px;
  }

  .quick-contact {
    display: flex;
    width: 100%;
    min-width: 0;
    flex: 1 1 100%;
    align-items: center;
    gap: 0.55rem;
  }

  .quick-icon-bubble {
    display: inline-flex;
    height: 2.25rem;
    width: 2.25rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border: 1px solid #d1d5db;
    border-radius: 999px;
    background: #fff;
    color: #374151;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.07);
    transition:
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.25s ease,
      color 0.25s ease,
      box-shadow 0.3s ease;
  }

  .quick-link-icon {
    width: 1.1rem;
    height: 1.1rem;
    flex-shrink: 0;
    color: inherit;
  }

  .qr-link {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    width: 3rem;
    height: 3rem;
    z-index: 10;
    cursor: pointer;
    border-radius: 0.5rem;
  }

  .contact-qr {
    width: 100%;
    height: 100%;
    color: #e2e8f0;
    opacity: 0.8;
    pointer-events: none;
    filter: drop-shadow(0 1px 0 rgba(15, 23, 42, 0.35))
      drop-shadow(0 0 1px rgba(255, 255, 255, 0.18));
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.42),
      rgba(148, 163, 184, 0.32)
    );
    border-radius: 0.5rem;
  }

  .quick-link:hover,
  .quick-link:focus-visible,
  .quick-contact:hover .quick-link,
  .quick-contact:focus-within .quick-link {
    border-color: var(--accent);
    color: var(--accent);
    box-shadow: 0 7px 16px rgba(15, 23, 42, 0.08);
    transform: translateY(-2px);
    outline: none;
  }

  .quick-link:active {
    transform: translateY(0) scale(0.98);
  }

  .quick-contact:has(.quick-link:active) .quick-link {
    transform: translateY(0) scale(0.98);
  }

  .quick-contact:active .quick-icon-bubble {
    transform: translateY(0) scale(0.96);
  }

  .quick-contact:active .quick-link {
    transform: translateY(0) scale(0.98);
  }

  .quick-contact:hover .quick-icon-bubble,
  .quick-contact:focus-within .quick-icon-bubble {
    border-color: var(--accent);
    color: var(--accent);
    box-shadow: 0 7px 16px rgba(15, 23, 42, 0.12);
    transform: translateY(-2px) scale(1.05) rotate(-4deg);
  }

  .quick-contact:has(.quick-link:active) .quick-icon-bubble {
    transform: translateY(0) scale(0.96);
  }

  @media (max-width: 768px) {
    .contact-image {
      min-height: 220px;
    }

    .quick-link {
      padding: 0.4rem 0.75rem;
      font-size: 0.82rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-qr {
      animation: none;
      filter: none;
    }
  }
</style>

<script>
  const contactForm = document.getElementById("contactForm");
  const formStatus = document.getElementById("formStatus");
  const submitButton = contactForm?.querySelector<HTMLButtonElement>(
    'button[type="submit"]',
  );
  const planField = document.getElementById(
    "selectedPlan",
  ) as HTMLInputElement | null;
  const selectedPlanWrapper = document.getElementById("selectedPlanWrapper");
  const timelineBudgetGroup = document.getElementById("timelineBudgetGroup");
  const timelineField = document.getElementById(
    "timeline",
  ) as HTMLSelectElement | null;
  const budgetField = document.getElementById(
    "budget",
  ) as HTMLSelectElement | null;

  function setPlanSelectionState(hasPlan: boolean) {
    selectedPlanWrapper?.classList.toggle("hidden", !hasPlan);
    timelineBudgetGroup?.classList.toggle("hidden", hasPlan);
  }

  function showFormStatus(message: string, type: "success" | "error") {
    if (!formStatus) {
      return;
    }

    formStatus.textContent = message;
    formStatus.className = `mt-4 rounded-md border px-3 py-2 text-sm ${
      type === "success"
        ? "border-green-200 bg-green-50 text-green-700"
        : "border-red-200 bg-red-50 text-red-700"
    }`;
  }

  function hideFormStatus() {
    formStatus?.classList.add("hidden");
  }

  setPlanSelectionState(false);

  contactForm?.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (!(event.currentTarget instanceof HTMLFormElement)) {
      return;
    }

    const form = event.currentTarget;

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const originalText = submitButton?.textContent || "Submit Project Brief";
    hideFormStatus();

    if (submitButton) {
      submitButton.textContent = "Sending...";
      submitButton.disabled = true;
    }

    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
      });
      const data = await response.json();

      if (!response.ok || !data.success) {
        showFormStatus(
          data.message || "Something went wrong. Please try again.",
          "error",
        );
        return;
      }

      showFormStatus(
        "Thanks! Your inquiry has been sent. I’ll reply soon.",
        "success",
      );
      form.reset();
      if (planField) {
        planField.value = "";
      }
      setPlanSelectionState(false);
    } catch (error) {
      showFormStatus(
        "Something went wrong. Please try again or use WhatsApp.",
        "error",
      );
    } finally {
      if (submitButton) {
        submitButton.textContent = originalText;
        submitButton.disabled = false;
      }
    }
  });

  window.addEventListener("pricing-plan-selected", (event) => {
    const payload =
      (event as CustomEvent<{ plan?: string; mode?: string }>).detail || {};
    const plan = String(payload.plan || "").trim();
    const mode = String(payload.mode || "project").trim();

    if (!plan || !contactForm) {
      return;
    }

    const modeLabel = mode === "monthly" ? "Monthly Retainer" : "Per Project";
    const budgetPrefill =
      plan === "Starter"
        ? "₹1k–₹3k (Basic)"
        : plan === "Growth"
          ? "₹3k–₹10k (Standard)"
          : "₹10k–₹25k (Advanced)";
    const timelinePrefill =
      mode === "monthly" ? "Flexible / No deadline" : "Standard (4–7 days)";

    if (planField) {
      planField.value = `${plan} (${modeLabel})`;
    }
    if (timelineField && !timelineField.value) {
      timelineField.value = timelinePrefill;
    }
    if (budgetField && !budgetField.value) {
      budgetField.value = budgetPrefill;
    }
    setPlanSelectionState(true);

    contactForm.classList.remove("contact-card-plan-selected");
    window.requestAnimationFrame(() => {
      contactForm.classList.add("contact-card-plan-selected");
    });
  });
</script>
