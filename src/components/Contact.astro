---
import { contact } from "../config/content";
import { site } from "../config/site";
---
<section id="contact" class="contact"><div class="shell" data-reveal><p class="eyebrow">{contact.label}</p><h2 class="display">{contact.heading}</h2><p class="body-lg" style="max-width:600px">{contact.body}</p><div class="contact-links"><a class="button" href={`mailto:${site.email}`}>Start a project <span aria-hidden="true">↗</span></a><a class="contact-link" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer">WhatsApp</a><a class="contact-link" href={`mailto:${site.email}`}>{site.email}</a></div></div></section>
