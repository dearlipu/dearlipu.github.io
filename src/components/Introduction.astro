---
import { positioning } from "../config/content";
---
<section id="approach" class="section"><div class="shell intro"><p class="eyebrow" data-reveal>{positioning.label}</p><div class="intro-text" data-reveal><h2 class="heading">{positioning.heading}</h2><p class="body-lg" style="margin-top:1.5rem">{positioning.body}</p><div class="note-list">{positioning.notes.map((note) => <span class="note">{note}</span>)}</div></div></div></section>
