---
import { siteConfig } from "../../config";
import {
  testimonials,
  clientAvatars,
  satisfactionMetric,
} from "../../data/reviews";
---

<section
  id="testimonials"
  class="site-section bg-white"
>
  <div class="mx-auto max-w-6xl reveal-up">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-4">
        <div class="badge-pill">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="icon icon-tabler icon-tabler-message-2"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
            <path d="M8 9h8"></path>
            <path d="M8 13h6"></path>
            <path
              d="M9 18h-3a3 3 0 0 1 -3 -3v-8a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v8a3 3 0 0 1 -3 3h-3l-3 3l-3 -3z"
            ></path>
          </svg>
          <span>Reviews</span>
        </div>

        <h2
          class="mt-4 text-3xl font-bold leading-tight text-gray-900 sm:text-4xl md:text-5xl"
        >
          What Clients Say.
        </h2>

        <div
          class="mt-3 h-1.5 w-20 rounded-full"
          style={`background-color: ${siteConfig.accentColor}`}
        >
        </div>

        <p
          class="mt-5 max-w-sm text-sm leading-relaxed text-gray-600 sm:text-base"
        >
          See what clients say about working with me on design, content, and
          video projects.
        </p>
      </div>

      <div class="lg:col-span-4">
        <article class="summary-card h-full">
          <div class="summary-card-icon" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-[180px] h-[180px] md:w-[240px] md:h-[240px] lg:w-[240px] lg:h-[240px]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#e5e7eb"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
              <path d="M12 21a9 9 0 1 1 0 -18a9 9 0 0 1 0 18"></path>
              <path d="M10 10c-.5 -1 -2.5 -1 -3 0"></path>
              <path d="M17 10c-.5 -1 -2.5 -1 -3 0"></path>
              <path d="M14.5 15a3.5 3.5 0 0 1 -5 0"></path>
            </svg>
          </div>
          <div>
            <p class="text-xs uppercase tracking-[0.16em] text-blue-200">
              {satisfactionMetric.label}
            </p>
            <h3 class="mt-2 text-4xl font-bold">
              <span
                id="satisfactionCounter"
                data-target={satisfactionMetric.percentage}>0</span
              ><span>%</span>
            </h3>
            <p class="mt-2 text-sm text-gray-300">
              {satisfactionMetric.description}
            </p>
          </div>

          <div class="mt-4 flex -space-x-5">
            {
              clientAvatars.map((av) => (
                <img src={av.src} alt={av.alt} class="avatar" />
              ))
            }
            <div
              class="w-10 h-10 rounded-full border-2 border-white bg-black/40 backdrop-blur-sm flex items-center justify-center"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-5 h-5 text-white"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                <path d="M12 5l0 14"></path>
                <path d="M5 12l14 0"></path>
              </svg>
            </div>
          </div>

          <p class="mt-4 text-xs text-gray-400">{satisfactionMetric.note}</p>
        </article>
      </div>

      <div class="lg:col-span-4">
        <div class="review-shell">
          <div id="reviewSlider" class="review-slider" aria-live="polite">
            {
              testimonials.map((item) => (
                <article
                  class="review-card"
                  aria-label={`Review by ${item.name}`}
                >
                  <div>
                    <div
                      class="mb-2 flex items-center gap-2 text-sm leading-none"
                      aria-label={`${item.rating} out of 5 stars`}
                    >
                      <span class="font-semibold text-gray-900">
                        {item.rating}
                      </span>
                      <div class="flex items-center gap-0.5" aria-hidden="true">
                        {Array(5)
                          .fill(0)
                          .map((_, starIndex) => {
                            const fill =
                              Math.max(
                                0,
                                Math.min(1, item.rating - starIndex),
                              ) * 100;

                            return (
                              <span class="relative block h-3.5 w-3.5 text-gray-300">
                                <svg
                                  xmlns="http://www.w3.org/2000/svg"
                                  class="absolute inset-0 h-full w-full"
                                  viewBox="0 0 24 24"
                                  fill="currentColor"
                                >
                                  <path d="M8.243 7.34l-6.38 .925l-.113 .023a1 1 0 0 0 -.44 1.684l4.622 4.499l-1.09 6.355l-.013 .11a1 1 0 0 0 1.464 .944l5.706 -3l5.693 3l.1 .046a1 1 0 0 0 1.352 -1.1l-1.091 -6.355l4.624 -4.5l.078 -.085a1 1 0 0 0 -.633 -1.62l-6.38 -.926l-2.852 -5.78a1 1 0 0 0 -1.794 0l-2.853 5.78z" />
                                </svg>
                                <span
                                  class="absolute inset-y-0 left-0 overflow-hidden text-amber-400"
                                  style={`width: ${fill}%`}
                                >
                                  <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="h-3.5 w-3.5"
                                    viewBox="0 0 24 24"
                                    fill="currentColor"
                                  >
                                    <path d="M8.243 7.34l-6.38 .925l-.113 .023a1 1 0 0 0 -.44 1.684l4.622 4.499l-1.09 6.355l-.013 .11a1 1 0 0 0 1.464 .944l5.706 -3l5.693 3l.1 .046a1 1 0 0 0 1.352 -1.1l-1.091 -6.355l4.624 -4.5l.078 -.085a1 1 0 0 0 -.633 -1.62l-6.38 -.926l-2.852 -5.78a1 1 0 0 0 -1.794 0l-2.853 5.78z" />
                                  </svg>
                                </span>
                              </span>
                            );
                          })}
                      </div>
                      <span class="text-gray-500">
                        out of 5.0
                      </span>
                    </div>

                    <p class="text-sm leading-relaxed text-gray-700">
                      "{item.quote}"
                    </p>
                  </div>

                  <div class="mt-6 flex items-center gap-3">
                    <img
                      src={item.avatar}
                      alt={`${item.name} avatar`}
                      class="h-10 w-10 rounded-full border border-white object-cover shadow"
                    />
                    <div>
                      <p class="text-sm font-semibold text-gray-900">
                        {item.name}
                      </p>
                      <p class="text-xs text-gray-500">{item.role}</p>
                    </div>
                  </div>
                </article>
              ))
            }
          </div>

          <div
            id="reviewDots"
            class="mt-4 flex items-center justify-center gap-2"
          >
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .summary-card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-radius: 1rem;
    background: linear-gradient(160deg, #0f172a, #111827);
    padding: 1.25rem;
    color: #fff;
    box-shadow: 0 10px 35px rgba(15, 23, 42, 0.25);
  }

  /* Fixed: removed invalid md:right / md:top pseudo-properties */
  .summary-card-icon {
    position: absolute;
    right: -40px;
    top: -40px;
    opacity: 0.06;
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .summary-card-icon {
      right: -60px;
      top: -60px;
    }
  }

  .avatar {
    height: 2.5rem;
    width: 2.5rem;
    border-radius: 999px;
    border: 2px solid #fff;
    object-fit: cover;
  }

  .avatar-more {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.14);
    font-size: 0.72rem;
    font-weight: 700;
    color: #fff;
  }

  .review-shell {
    height: 100%;
    overflow: hidden;
  }

  .review-slider {
    display: flex;
    height: 100%;
    transition: transform 0.45s ease;
  }

  .review-card {
    min-width: 100%;
    display: flex;
    min-height: 100%;
    flex-direction: column;
    justify-content: space-between;
    border: 1px solid #e5e7eb;
    background: #f9fafb;
    color: #111827;
    padding: 1.25rem;
    box-shadow: 0 10px 35px rgba(15, 23, 42, 0.08);
  }

  .review-dot {
    position: relative;
  }

  .review-dot-active {
    color: var(--accent);
  }
</style>

<script>
  import "../../scripts/reviews";
</script>
