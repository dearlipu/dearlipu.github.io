---
import { siteConfig } from "../config";
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
const visibleProjects = siteConfig.projects.slice(0, 3);
const hiddenProjects = siteConfig.projects.slice(3);
---

{
  hasProjects && (
    <section id="projects" class="page-shell content-section" data-reveal>
      <div class="section-heading">
        <span class="eyebrow">02 / selected work</span>
      </div>
      <div class="project-list">
        {visibleProjects.map((project, index) => (
          <article class="project-row" data-reveal>
            <span class="project-number">
              {String(index + 1).padStart(2, "0")}
            </span>
            <div class="project-main">
              <h3>
                {project.link && project.link !== "#" ? (
                  <a
                    class="project-link"
                    href={project.link}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {project.name}
                  </a>
                ) : (
                  project.name
                )}
                {project.isNew && <span class="new-badge">New</span>}
              </h3>
              <p>{project.description}</p>
            </div>
            <div class="project-meta">
              <div class="project-skills" aria-label="Project skills">
                {project.skills?.map((skill) => (
                  <span>{skill}</span>
                ))}
              </div>
              {project.link && project.link !== "#" && (
                <a
                  class="project-arrow"
                  href={project.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Open ${project.name}`}
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                    <path d="M17 7l-10 10" />
                    <path d="M8 7l9 0l0 9" />
                  </svg>
                </a>
              )}
            </div>
          </article>
        ))}

        {hiddenProjects.length > 0 && (
          <div
            class="project-extra"
            data-projects-extra
            id="project-extra"
            inert
          >
            <div class="project-extra-inner">
              {hiddenProjects.map((project, extraIndex) => (
                <article
                  class="project-row project-row-extra"
                  data-reveal
                >
                  <span class="project-number">
                    {String(visibleProjects.length + extraIndex + 1).padStart(
                      2,
                      "0",
                    )}
                  </span>
                  <div class="project-main">
                    <h3>
                      {project.link && project.link !== "#" ? (
                        <a
                          class="project-link"
                          href={project.link}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {project.name}
                        </a>
                      ) : (
                        project.name
                      )}
                      {project.isNew && <span class="new-badge">New</span>}
                    </h3>
                    <p>{project.description}</p>
                  </div>
                  <div class="project-meta">
                    <div class="project-skills" aria-label="Project skills">
                      {project.skills?.map((skill) => (
                        <span>{skill}</span>
                      ))}
                    </div>
                    {project.link && project.link !== "#" && (
                      <a
                        class="project-arrow"
                        href={project.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`Open ${project.name}`}
                      >
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="24"
                          height="24"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                          <path d="M17 7l-10 10" />
                          <path d="M8 7l9 0l0 9" />
                        </svg>
                      </a>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </div>
        )}

        {hiddenProjects.length > 0 && (
          <div class="project-toggle-wrap">
            <button
              class="project-toggle"
              type="button"
              data-project-toggle
              aria-controls="project-extra"
              aria-expanded="false"
            >
              More projects
            </button>
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  .project-list {
    margin-top: 0;
  }
  .project-extra {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition:
      max-height 420ms cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 280ms ease,
      margin-top 280ms ease;
  }
  .project-extra.is-expanded {
    max-height: 2600px;
    opacity: 1;
    margin-top: 0.5rem;
  }
  .project-row {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) 13rem;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: start;
    border-bottom: 1px solid var(--line);
    padding: clamp(1.25rem, 2.5vw, 1.75rem) 0;
    transition: border-color 180ms ease;
  }

  .project-row:hover {
    border-color: var(--accent);
  }

  .project-number,
  .project-meta {
    color: var(--muted);
    font-size: 0.8rem;
  }

  .project-number {
    padding-top: 0.4rem;
    font-variant-numeric: tabular-nums;
  }

  h3 {
    margin: 0;
    font-family: var(--title-font);
    font-size: clamp(1.65rem, 2.8vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .project-link {
    color: inherit;
    text-decoration: none;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.16em;
  }
  .project-link:hover,
  .project-link:focus-visible {
    color: var(--accent);
    text-decoration: underline;
  }

  .new-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-left: 0.75rem;
    padding: 0.18rem 0.4rem;
    border: 1px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    color: var(--accent);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.1;
    text-transform: uppercase;
    vertical-align: middle;
    white-space: nowrap;
  }

  .project-main p {
    max-width: 46rem;
    margin: 0.85rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .project-meta {
    display: flex;
    justify-content: flex-end;
    align-items: flex-start;
    gap: 12px;
  }

  .project-skills {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.35rem;
    max-width: 13rem;
  }

  .project-skills span {
    border: 1px solid var(--line);
    padding: 0.15rem 0.45rem;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.4;
  }

  .project-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    border: 1px solid var(--line);
    border-radius: 0;
    color: var(--ink);
    line-height: 1;
    transition: border-color 180ms ease, color 180ms ease;
  }

  .project-arrow:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .project-arrow svg {
    display: block;
    width: 1.1rem;
    height: 1.1rem;
  }
  .project-toggle-wrap {
    display: flex;
    justify-content: flex-end;
    margin-top: 1.5rem;
  }

  .project-toggle {
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink);
    min-height: 44px;
    padding: 0.65rem 1rem;
    font-family: inherit;
    font-size: 0.9rem;
    cursor: pointer;
    transition: border-color 180ms ease, color 180ms ease,
      background-color 180ms ease;
  }

  .project-toggle:hover,
  .project-toggle:focus-visible {
    border-color: var(--accent);
    background: var(--hover-surface);
    color: var(--accent);
  }

  @media (max-width: 800px) {
    .project-row {
      grid-template-columns: 2rem minmax(0, 1fr);
      gap: 1rem;
    }

    .project-meta {
      position: relative;
      grid-column: 2;
      justify-content: flex-start;
      padding-right: 44px;
    }

    .project-meta div {
      justify-content: flex-start;
    }

    .project-arrow {
      position: absolute;
      top: 0;
      right: 0;
    }

    .project-skills {
      max-width: none;
      align-items: flex-start;
    }
  }
</style>

<script>
  const toggleButton =
    document.querySelector<HTMLButtonElement>("[data-project-toggle]");
  const extraSection =
    document.querySelector<HTMLElement>("[data-projects-extra]");

  if (toggleButton && extraSection) {
    toggleButton.addEventListener("click", () => {
      const isExpanded = extraSection.classList.toggle("is-expanded");
      extraSection.inert = !isExpanded;
      toggleButton.setAttribute("aria-expanded", String(isExpanded));
      toggleButton.textContent = isExpanded
        ? "Show fewer projects"
        : "More projects";
    });
  }
</script>
