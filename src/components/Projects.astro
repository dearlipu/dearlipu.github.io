---
import { siteConfig } from "../config";

const projects = siteConfig.projects || [];
const hasProjects = projects.length > 0;
---

{
  hasProjects && (
    <section id="projects" class="bg-white px-6 py-14 sm:px-10 sm:py-16 md:px-14 lg:px-20 lg:py-24">
      <div class="mx-auto max-w-6xl reveal-up">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-14">
          <div class="lg:col-span-4">
            <p class="inline-flex rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-blue-700">
              Projects
            </p>

            <h2 class="mt-4 text-3xl font-bold leading-tight text-gray-900 sm:text-4xl md:text-5xl">
              Client Results.
            </h2>

            <div class="mt-3 h-1.5 w-20 rounded-full" style={`background-color: ${siteConfig.accentColor}`}></div>

            <p class="mt-5 max-w-sm text-sm leading-relaxed text-gray-600 sm:text-base">
              Examples of how clear design and video work can help a brand grow and communicate better.
            </p>
          </div>

          <div class="lg:col-span-8">
            <div class="project-grid">
              {projects.map((project, index) => (
                  <article class="project-card group relative" tabindex="0" role="button" aria-expanded="false">
                    <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-gray-50 p-4 transition-all duration-300 sm:rounded-2xl sm:p-5">
                      <div class="space-y-3">
                        <div>
                          <span class="project-number text-xs font-semibold tracking-[0.12em]" style={{ color: siteConfig.accentColor }}>
                            # 0{index + 1}
                          </span>
                          <h3 class="mt-1 text-lg font-bold text-gray-900 sm:text-xl">{project.name}</h3>
                        </div>

                        <p class="text-sm leading-relaxed text-gray-600 sm:text-base">{project.description}</p>

                        {project.skills && project.skills.length > 0 && (
                          <div class="flex flex-wrap gap-1.5 pt-1">
                            {project.skills.map((skill) => (
                              <span class="rounded-md bg-gray-900 px-2.5 py-1 text-xs font-medium text-white sm:rounded-lg sm:text-sm">
                                {skill}
                              </span>
                            ))}
                          </div>
                        )}
                    </div>
                      <div class="project-image-reveal" aria-hidden="true">
                        <img src={project.images?.[0]?.src} alt="" loading="lazy" decoding="async" />
                      </div>
                    </div>
                  </article>
                ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  .project-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .project-card {
    min-width: 0;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), filter 0.3s ease;
  }

  .project-card::before {
    position: absolute;
    inset: 0.35rem;
    z-index: 0;
    border-radius: 0.9rem;
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.15), transparent 45%);
    content: "";
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .project-card > div {
    position: relative;
    z-index: 1;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.05);
  }

  .project-image-reveal {
    position: absolute;
    inset: 0;
    z-index: 2;
    overflow: hidden;
    background: rgba(15, 23, 42, 0.18);
    clip-path: polygon(100% 100%, 100% 100%, 100% 100%, 100% 100%);
    pointer-events: none;
    transition: clip-path 0.7s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.5s ease;
  }

  .project-image-reveal::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(15, 23, 42, 0.12), rgba(15, 23, 42, 0.36));
    content: "";
  }

  .project-image-reveal img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.1);
    transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-card:hover {
    transform: translateY(-4px);
    filter: saturate(1.05);
  }

  .project-card:not(.is-closed):hover .project-image-reveal,
  .project-card:not(.is-closed):focus .project-image-reveal,
  .project-card.is-active .project-image-reveal {
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
    background: rgba(15, 23, 42, 0.08);
  }

  .project-card:not(.is-closed):hover .project-image-reveal img,
  .project-card:not(.is-closed):focus .project-image-reveal img,
  .project-card.is-active .project-image-reveal img {
    transform: scale(1);
  }

  .project-card:hover::before {
    opacity: 1;
  }

  @media (min-width: 640px) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-image-reveal,
    .project-image-reveal img {
      transition: none;
    }
  }

</style>

<script>
  document.querySelectorAll<HTMLElement>(".project-card").forEach((card) => {
    card.addEventListener("click", () => {
      const isActive = !card.classList.contains("is-active");
      card.classList.toggle("is-active", isActive);
      card.classList.toggle("is-closed", !isActive);
      card.setAttribute("aria-expanded", String(isActive));
    });

    card.addEventListener("keydown", (event: KeyboardEvent) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        card.click();
      }
    });
  });
</script>
