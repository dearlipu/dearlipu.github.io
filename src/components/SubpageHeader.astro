---
import { siteConfig } from "../config";
---

<header
  class="w-full border-b border-gray-200/80 bg-white/85 backdrop-blur-md sticky top-0 z-40 transition-all duration-300 shadow-2xs"
>
  <div
    class="max-w-6xl mx-auto px-6 sm:px-10 md:px-14 lg:px-20 py-3 flex items-center justify-between"
  >
    <a href="/" class="btn-back-home group" aria-label="Back to home">
      <span class="btn-back-icon">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="icon icon-tabler icon-tabler-arrow-left w-4 h-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
          <path d="M5 12l14 0"></path>
          <path d="M5 12l6 6"></path>
          <path d="M5 12l6 -6"></path>
        </svg>
      </span>
      <span>Back to Home</span>
    </a>

    <nav
      class="flex items-center gap-1.5 sm:gap-3"
      aria-label="Subpage navigation"
    >
      <a href="/#services" class="subnav-link hidden sm:inline-flex">
        <span>Services</span>
      </a>
      <a href="/#pricing" class="subnav-link hidden sm:inline-flex">
        <span>Pricing</span>
      </a>
      <a href="/#contact" class="btn-nav">
        <span>Get in Touch</span>
      </a>
    </nav>
  </div>
</header>
