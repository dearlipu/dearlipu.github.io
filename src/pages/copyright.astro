---
import BaseLayout from "../layouts/BaseLayout.astro";
import SubpageHeader from "../components/SubpageHeader.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../config";

const pageTitle = `Copyright Notice | ${siteConfig.siteName}`;
const pageDescription =
  "Copyright Notice for dearlipu. Details on intellectual property, visual assets, and content usage.";

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: `${siteConfig.siteUrl}/`,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Copyright Notice",
      item: `${siteConfig.siteUrl}/copyright`,
    },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={`${siteConfig.siteUrl}/copyright`}
  jsonLd={breadcrumbSchema}
>
  <SubpageHeader />

  <main>
    <section
      class="px-6 sm:px-10 md:px-16 lg:px-24 py-12 md:py-16 lg:py-24 overflow-x-hidden"
    >
      <div
        class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start"
      >
        <!-- LEFT COLUMN -->
        <div class="lg:col-span-4 lg:sticky lg:top-24">
          <div class="badge-pill">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="icon icon-tabler icon-tabler-copyright"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
              <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
              <path
                d="M14 9.75a3.016 3.016 0 0 0 -4.163 .173a2.993 2.993 0 0 0 0 4.154a3.016 3.016 0 0 0 4.163 .173"
              ></path>
            </svg>
            <span>Intellectual Property</span>
          </div>

          <h1
            class="mt-4 text-3xl sm:text-4xl md:text-5xl xl:text-6xl font-extrabold tracking-tight text-gray-900 leading-[1.15]"
          >
            Copyright Notice.
          </h1>

          <div
            class="w-16 h-1.5 mt-4 rounded-full"
            style={`background-color: ${siteConfig.accentColor}`}
          >
          </div>

          <p class="text-gray-600 mt-5 text-base sm:text-lg leading-relaxed">
            Ownership information, asset credits, and usage rights for content
            on this website.
          </p>

          <div
            class="mt-8 rounded-2xl border border-gray-200/80 bg-linear-to-b from-white to-gray-50/80 p-5 shadow-xs"
          >
            <p class="text-xs font-bold uppercase tracking-wider text-gray-500">
              Attribution questions?
            </p>
            <p class="mt-1 text-sm font-medium text-gray-800">
              For any copyright or usage inquiries:
            </p>
            <a
              href={`mailto:${siteConfig.social.email}`}
              class="group mt-3 inline-flex items-center gap-2 text-sm font-semibold text-blue-700 hover:text-blue-800 transition-colors"
            >
              <span class="inline-block transform translate-y-[1px]"
                >{siteConfig.social.email}</span
              >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="icon icon-tabler icon-tabler-arrow-right w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                <path d="M5 12l14 0"></path>
                <path d="M13 18l6 -6"></path>
                <path d="M13 6l6 6"></path>
              </svg>
            </a>
          </div>
        </div>

        <!-- RIGHT COLUMN -->
        <div class="lg:col-span-8 w-full min-w-0">
          <div
            class="bg-linear-to-b from-gray-50/80 to-white border border-gray-200 rounded-3xl p-6 sm:p-10 md:p-12 shadow-sm"
          >
            <div
              class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white border border-gray-200 text-xs font-semibold text-gray-500 mb-8 shadow-2xs"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="icon icon-tabler icon-tabler-calendar w-3.5 h-3.5 text-gray-400"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                <path
                  d="M4 7a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-12z"
                ></path>
                <path d="M16 3v4"></path>
                <path d="M8 3v4"></path>
                <path d="M4 11h16"></path>
                <path d="M11 15h1"></path>
                <path d="M12 15v3"></path>
              </svg>
              <span class="inline-block transform translate-y-[1px]"
                >Last updated: August 2026</span
              >
            </div>

            <div
              class="space-y-6 text-base sm:text-lg leading-relaxed text-gray-600"
            >
              <p>
                Unless stated otherwise, {siteConfig.name} owns the original text,
                branding, custom graphics, and project presentations on this website.
              </p>

              <p>
                Some visual elements may use public references, design patterns,
                icon sets, or licensed resources. Where applicable, credit and
                rights remain with their original owners.
              </p>

              <p>
                Some GIF-style illustrations in the service cards were sourced
                from Pinterest and are shown for visual presentation only.
              </p>

              <p>
                If you believe any material needs different credit or should be
                removed, please contact me. I will review valid requests and
                respond promptly.
              </p>

              <p>
                You may not copy, republish, or distribute original content from
                this website for commercial use without written permission.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
