---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Hero from "../components/sections/Hero.astro";
import About from "../components/sections/About.astro";
import Services from "../components/sections/Services.astro";
import Footer from "../components/layout/Footer.astro";
import Pricing from "../components/sections/Pricing.astro";
import Reviews from "../components/sections/Reviews.astro";
import Contact from "../components/sections/Contact.astro";
import BackToTop from "../components/layout/BackToTop.astro";
import { siteConfig } from "../config";

const personSchema = {
  "@type": "Person",
  "@id": `${siteConfig.siteUrl}/#person`,
  name: siteConfig.name,
  alternateName: ["dearlipu", "Dearlipu"],
  url: `${siteConfig.siteUrl}/`,
  image: `${siteConfig.siteUrl}/social-card.png`,
  sameAs: [
    siteConfig.social.instagram,
    siteConfig.social.twitter,
    siteConfig.social.youtube,
  ],
  jobTitle: "Visual Designer and Video Editor",
  knowsAbout: [
    "Visual Design",
    "Video Editing",
    "Motion Graphics",
    "Brand Strategy",
  ],
  description: siteConfig.description,
};

const websiteSchema = {
  "@type": "WebSite",
  "@id": `${siteConfig.siteUrl}/#website`,
  name: siteConfig.siteName,
  alternateName: ["Dearlipu", "dearlipu.is-a.dev"],
  url: `${siteConfig.siteUrl}/`,
  inLanguage: "en-US",
  publisher: { "@id": `${siteConfig.siteUrl}/#person` },
  creator: { "@id": `${siteConfig.siteUrl}/#person` },
};

const professionalServiceSchema = {
  "@type": "ProfessionalService",
  "@id": `${siteConfig.siteUrl}/#service`,
  name: siteConfig.siteName,
  url: `${siteConfig.siteUrl}/`,
  image: `${siteConfig.siteUrl}/social-card.png`,
  description: siteConfig.description,
  provider: { "@id": `${siteConfig.siteUrl}/#person` },
  serviceType: [
    "Brand & Social Design",
    "Video Editing & Motion",
    "Print & Layout Design",
  ],
  areaServed: "Worldwide",
  availableLanguage: "English",
};
---

<BaseLayout
  title={siteConfig.siteTitle}
  description={siteConfig.description}
  canonicalUrl={`${siteConfig.siteUrl}/`}
  jsonLd={[websiteSchema, personSchema, professionalServiceSchema]}
>
  <Header />

  <main>
    <Hero />
    <About />
    <Services />
    <Pricing />
    <Reviews />
    <Contact />
  </main>

  <Footer />
  <BackToTop />
</BaseLayout>
