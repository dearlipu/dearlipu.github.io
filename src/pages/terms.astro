---
import BaseLayout from "../layouts/BaseLayout.astro";
import SubpageHeader from "../components/SubpageHeader.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../config";

const pageTitle = `Terms of Service | ${siteConfig.siteName}`;
const pageDescription =
  "Terms & Conditions for dearlipu (Saurav Panda) design and video editing services.";

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: `${siteConfig.siteUrl}/`,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Terms of Service",
      item: `${siteConfig.siteUrl}/terms`,
    },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={`${siteConfig.siteUrl}/terms`}
  jsonLd={breadcrumbSchema}
>
  <SubpageHeader />

  <main>
    <section
      class="px-6 sm:px-10 md:px-16 lg:px-24 py-12 md:py-16 lg:py-24 overflow-x-hidden"
    >
      <div
        class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start"
      >
        <!-- LEFT COLUMN -->
        <div class="lg:col-span-4 lg:sticky lg:top-24">
          <div class="badge-pill">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="icon icon-tabler icon-tabler-scale"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
              <path d="M7 20l10 0"></path>
              <path d="M6 6l6 -1l6 1"></path>
              <path d="M12 3l0 17"></path>
              <path d="M9 12l-3 -6l-3 6a3 3 0 0 0 6 0"></path>
              <path d="M21 12l-3 -6l-3 6a3 3 0 0 0 6 0"></path>
            </svg>
            <span>Terms & Conditions</span>
          </div>

          <h1
            class="mt-4 text-3xl sm:text-4xl md:text-5xl xl:text-6xl font-extrabold tracking-tight text-gray-900 leading-[1.15]"
          >
            Terms of Service.
          </h1>

          <div
            class="w-16 h-1.5 mt-4 rounded-full"
            style={`background-color: ${siteConfig.accentColor}`}
          >
          </div>

          <p class="text-gray-600 mt-5 text-base sm:text-lg leading-relaxed">
            The main rules, agreements, and mutual responsibilities for using
            this website or working with me.
          </p>

          <div
            class="mt-8 rounded-2xl border border-gray-200/80 bg-linear-to-b from-white to-gray-50/80 p-5 shadow-xs"
          >
            <p class="text-xs font-bold uppercase tracking-wider text-gray-500">
              Questions about terms?
            </p>
            <p class="mt-1 text-sm font-medium text-gray-800">
              For any project agreements or contract questions:
            </p>
            <a
              href={`mailto:${siteConfig.social.email}`}
              class="group mt-3 inline-flex items-center gap-2 text-sm font-semibold text-blue-700 hover:text-blue-800 transition-colors"
            >
              <span class="inline-block transform translate-y-[1px]"
                >{siteConfig.social.email}</span
              >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="icon icon-tabler icon-tabler-arrow-right w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                <path d="M5 12l14 0"></path>
                <path d="M13 18l6 -6"></path>
                <path d="M13 6l6 6"></path>
              </svg>
            </a>
          </div>
        </div>

        <!-- RIGHT COLUMN -->
        <div class="lg:col-span-8 w-full min-w-0">
          <div
            class="bg-linear-to-b from-gray-50/80 to-white border border-gray-200 rounded-3xl p-6 sm:p-10 md:p-12 shadow-sm"
          >
            <div
              class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white border border-gray-200 text-xs font-semibold text-gray-500 mb-8 shadow-2xs"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="icon icon-tabler icon-tabler-calendar w-3.5 h-3.5 text-gray-400"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                <path
                  d="M4 7a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-12z"
                ></path>
                <path d="M16 3v4"></path>
                <path d="M8 3v4"></path>
                <path d="M4 11h16"></path>
                <path d="M11 15h1"></path>
                <path d="M12 15v3"></path>
              </svg>
              <span class="inline-block transform translate-y-[1px]"
                >Last updated: August 2026</span
              >
            </div>

            <div
              class="space-y-6 text-base sm:text-lg leading-relaxed text-gray-600"
            >
              <p>
                By using this website or working with me, you agree to these
                terms. If you do not agree, please stop using the website and
                services.
              </p>

              <p>
                All original content on this website, including text, branding,
                custom visuals, and layout, is protected by copyright and other
                applicable laws. You may not copy or reuse it without written
                permission.
              </p>

              <p>
                I provide services based on an agreed project plan. We confirm
                the price, timeline, and files you will receive before work
                begins. New requests may need an extra fee or more time.
              </p>

              <p>
                An advance payment may be required to reserve your project. I
                deliver final files after full payment. Unless we agree
                otherwise in writing, payments are non-refundable after work
                begins.
              </p>

              <p>
                The number of revisions depends on your package or agreement.
                Minor changes are included; a major change in direction may be
                treated as new work.
              </p>

              <p>
                Delivery dates are estimates and may change based on project
                complexity and how quickly I receive feedback. I am not
                responsible for delays caused by missing information or late
                replies.
              </p>

              <p>
                You are responsible for making sure that the content, materials,
                and assets you provide are yours or properly licensed. You are
                responsible for any legal issues caused by those materials.
              </p>

              <p>
                After final payment, you receive usage rights for the final
                files unless we agree otherwise. I may still show completed work
                in my portfolio, social media, or promotional materials.
              </p>

              <p>
                I work to provide reliable, high-quality services, but services
                are provided "as is" and cannot be guaranteed to meet every
                expectation or work perfectly in every situation. I am not
                responsible for indirect losses, damage, or business impact
                caused by using the delivered work.
              </p>

              <p>
                This website may link to third-party platforms or tools. I am
                not responsible for their content, policies, or practices.
              </p>

              <p>
                I may update these terms from time to time. Continued use of the
                website or services after an update means you accept the revised
                terms.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
