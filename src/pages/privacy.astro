---
import { siteConfig } from "../config";
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anek+Devanagari:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <title>Privacy Policy</title>
  </head>

  <body class="bg-white text-gray-800">

    <section class="px-6 sm:px-10 md:px-16 lg:px-24 py-12 md:py-16 lg:py-20 overflow-x-hidden">

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-20 items-start">

        <!-- LEFT -->
        <div class="lg:col-span-4">

          <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
            Privacy Policy.
          </h2>

          <div
            class="w-[75px] h-[5px] mt-2 rounded-full"
            style={`background-color: ${siteConfig.accentColor}`}
          ></div>

          <p class="text-gray-500 mt-5 text-sm sm:text-base max-w-sm leading-relaxed">
            How I collect, use, and protect your information when you use this website or my services.
          </p>

        </div>

        <!-- RIGHT -->
        <div class="lg:col-span-8 w-full min-w-0">

          <div class="bg-gray-50 border border-gray-200 rounded-2xl 
                      p-6 sm:p-8 md:p-10 lg:p-12
                      shadow-sm hover:shadow-lg transition duration-300">

            <p class="text-xs text-gray-400 mb-6">
              Last updated: August 2026
            </p>

            <div class="space-y-8 text-lg sm:text-xl md:text-xl leading-relaxed text-gray-600">
            
              <p>
                I respect your privacy and handle your information with care. This policy explains what I collect, why I collect it, and how I use it when you visit this website or contact me.
              </p>
            
              <p>
                I may collect information you choose to share, such as your name, email address, project details, and messages you send through forms or other channels.
              </p>
            
              <p>
                I may also collect basic technical data, such as your IP address, browser type, pages visited, and time spent on the site. Cookies or similar tools may help me improve the site and understand how it is used.
              </p>
            
              <p>
                I use this information to answer questions, provide services, improve the website, and keep it secure and reliable.
              </p>
            
              <p>
                I do not sell or rent your personal information. I may share it with trusted third-party providers, such as hosting or communication services, only when needed to run this website or provide services.
              </p>
            
              <p>
                I may also share information when required by law or when needed to protect my rights, users, or services.
              </p>
            
              <p>
                Where applicable, you may ask to access, update, or delete your personal information. You may also stop receiving communications at any time.
              </p>
            
              <p>
                I take reasonable steps to protect your information, but no internet transmission is completely secure. By using this website, you accept this risk.
              </p>
            
              <p>
                This website may link to other websites. I am not responsible for their content or privacy practices.
              </p>
            
              <p>
                I may update this policy from time to time. Continued use of the website after an update means you accept the revised policy.
              </p>
            
              <!-- CONTACT -->
              <div class="pt-6">
                <p class="text-gray-500 text-base sm:text-lg">
                  For any privacy-related questions:
                </p>
            
                <p class="text-gray-900 font-medium mt-1">
                  {siteConfig.social.email}
                </p>
              </div>
            
            </div>

          </div>

        </div>

      </div>

    </section>

  </body>
</html>
