---
import BaseLayout from "../layouts/BaseLayout.astro";
import SubpageHeader from "../components/SubpageHeader.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../config";

const pageTitle = `Privacy Policy | ${siteConfig.siteName}`;
const pageDescription =
  "Privacy Policy for dearlipu (Saurav Panda). Learn how personal information and inquiries are handled.";

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: `${siteConfig.siteUrl}/`,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Privacy Policy",
      item: `${siteConfig.siteUrl}/privacy`,
    },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={`${siteConfig.siteUrl}/privacy`}
  jsonLd={breadcrumbSchema}
>
  <SubpageHeader />

  <main>
    <section
      class="px-6 sm:px-10 md:px-16 lg:px-24 py-12 md:py-16 lg:py-24 overflow-x-hidden"
    >
      <div
        class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start"
      >
        <!-- LEFT COLUMN -->
        <div class="lg:col-span-4 lg:sticky lg:top-24">
          <div class="badge-pill">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="icon icon-tabler icon-tabler-shield-check"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
              <path
                d="M12 3a12 12 0 0 0 8.5 3a12 12 0 0 1 -8.5 15a12 12 0 0 1 -8.5 -15a12 12 0 0 0 8.5 -3"
              ></path>
              <path d="M9 12l2 2l4 -4"></path>
            </svg>
            <span>Legal Policy</span>
          </div>

          <h1
            class="mt-4 text-3xl sm:text-4xl md:text-5xl xl:text-6xl font-extrabold tracking-tight text-gray-900 leading-[1.15]"
          >
            Privacy Policy.
          </h1>

          <div
            class="w-16 h-1.5 mt-4 rounded-full"
            style={`background-color: ${siteConfig.accentColor}`}
          >
          </div>

          <p class="text-gray-600 mt-5 text-base sm:text-lg leading-relaxed">
            How I collect, use, and protect your information when you use this
            website or work with me.
          </p>

          <div
            class="mt-8 rounded-2xl border border-gray-200/80 bg-linear-to-b from-white to-gray-50/80 p-5 shadow-xs"
          >
            <p class="text-xs font-bold uppercase tracking-wider text-gray-500">
              Have questions?
            </p>
            <p class="mt-1 text-sm font-medium text-gray-800">
              For any privacy or data inquiries:
            </p>
            <a
              href={`mailto:${siteConfig.social.email}`}
              class="group mt-3 inline-flex items-center gap-2 text-sm font-semibold text-blue-700 hover:text-blue-800 transition-colors"
            >
              <span class="inline-block transform translate-y-[1px]"
                >{siteConfig.social.email}</span
              >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="icon icon-tabler icon-tabler-arrow-right w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                <path d="M5 12l14 0"></path>
                <path d="M13 18l6 -6"></path>
                <path d="M13 6l6 6"></path>
              </svg>
            </a>
          </div>
        </div>

        <!-- RIGHT COLUMN -->
        <div class="lg:col-span-8 w-full min-w-0">
          <div
            class="bg-linear-to-b from-gray-50/80 to-white border border-gray-200 rounded-3xl p-6 sm:p-10 md:p-12 shadow-sm"
          >
            <div
              class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white border border-gray-200 text-xs font-semibold text-gray-500 mb-8 shadow-2xs"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="icon icon-tabler icon-tabler-calendar w-3.5 h-3.5 text-gray-400"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                <path
                  d="M4 7a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-12z"
                ></path>
                <path d="M16 3v4"></path>
                <path d="M8 3v4"></path>
                <path d="M4 11h16"></path>
                <path d="M11 15h1"></path>
                <path d="M12 15v3"></path>
              </svg>
              <span class="inline-block transform translate-y-[1px]"
                >Last updated: August 2026</span
              >
            </div>

            <div
              class="space-y-6 text-base sm:text-lg leading-relaxed text-gray-600"
            >
              <p>
                I respect your privacy and handle your information with care.
                This policy explains what I collect, why I collect it, and how I
                use it when you visit this website or contact me.
              </p>

              <p>
                I may collect information you choose to share, such as your
                name, email address, project details, and messages you send
                through forms or other channels.
              </p>

              <p>
                I may also collect basic technical data, such as your IP
                address, browser type, pages visited, and time spent on the
                site. Cookies or similar tools may help me improve the site and
                understand how it is used.
              </p>

              <p>
                I use this information to answer questions, provide services,
                improve the website, and keep it secure and reliable.
              </p>

              <p>
                I do not sell or rent your personal information. I may share it
                with trusted third-party providers, such as hosting or
                communication services, only when needed to run this website or
                provide services.
              </p>

              <p>
                I may also share information when required by law or when needed
                to protect my rights, users, or services.
              </p>

              <p>
                Where applicable, you may ask to access, update, or delete your
                personal information. You may also stop receiving communications
                at any time.
              </p>

              <p>
                I take reasonable steps to protect your information, but no
                internet transmission is completely secure. By using this
                website, you accept this risk.
              </p>

              <p>
                This website may link to other websites. I am not responsible
                for their content or privacy practices.
              </p>

              <p>
                I may update this policy from time to time. Continued use of the
                website after an update means you accept the revised policy.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
